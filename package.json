{
	"name": "ctf-platform",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm",
	"dependencies": {
		"@vinext/cloudflare": "latest",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"vinext": "latest"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "beta",
		"@tailwindcss/postcss": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"cf": "^1.0.0-beta.31",
		"happy-dom": "21.0.4",
		"tailwindcss": "latest",
		"typescript": "latest",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	},
	"type": "module",
	"overrides": {
		"satori": {
			"fflate": "0.7.5"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "vite preview",
		"deploy": "vinext-cloudflare deploy",
		"preview": "npm run build && npm run start --",
		"cf-typegen": "cf workers types",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"db:migrate:local": "cf d1 migrations apply 3d05ae4a-7641-4bc7-8c46-08edc42f201d --local --dir migrations",
		"check:foundation": "node scripts/check-foundation.mjs"
	}
}
