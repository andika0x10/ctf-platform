# Run npm run auth:setup to create .dev.vars with a random application secret.
# Obtain a Google OAuth Web application client and set its credentials below.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google email addresses; only verified matching accounts become organizers.
ORGANIZER_EMAILS=
# Independent key for flag digests. Keep it stable; changing it requires re-entering flags.
FLAG_SIGNING_SECRET=
